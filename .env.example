# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret-string
# Production (girlsclub.ques.kg): set this to False.
DJANGO_DEBUG=True
# Production example: girlsclub.ques.kg,www.girlsclub.ques.kg
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Needed for checkout/admin POSTs to pass CSRF checks once served over
# HTTPS behind nginx. Production example: https://girlsclub.ques.kg
CSRF_TRUSTED_ORIGINS=

# Public base URL of the site, no trailing slash (used to build the
# payment callback/redirect URLs, the QR verification link, and links
# inside the confirmation email). Production: https://girlsclub.ques.kg
SITE_URL=http://127.0.0.1:8000

# --- Ticket price (KGS / сом) ---
TICKET_PRICE_KGS=2000

# --- FreedomPay ---
# Ask your FreedomPay account manager for these. Until they're set (or
# while FREEDOMPAY_TEST_MODE=True), the "Buy ticket" flow uses a local
# fake payment page instead of the real gateway, so the whole order ->
# QR code -> email flow can be tested end-to-end without real keys.
#
# Before switching this to False: FreedomPay only accepts requests from
# whitelisted server IPs (register the production server's IP in the
# FreedomPay merchant cabinet first, or every call fails with
# "<IP> отсутствует в списке доверенных").
FREEDOMPAY_TEST_MODE=True
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
# Base API URL FreedomPay gave you for payment initiation, e.g.
# https://api.freedompay.kz/init_payment.php — confirm the exact path
# and parameter names against the docs that come with your merchant
# account; see tickets/freedompay.py for where to adjust this.
FREEDOMPAY_API_URL=https://api.freedompay.kz/init_payment.php

# --- Email (for sending the QR code ticket) ---
# Default: prints emails to the runserver console, good for local testing.
# For real delivery: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Fairy Tale Picnic <no-reply@example.com>

# --- Database ---
# Leave POSTGRES_HOST empty to use local SQLite (e.g. plain
# "python manage.py runserver" outside Docker). docker-compose.yml sets
# POSTGRES_HOST=db itself — only POSTGRES_DB/USER/PASSWORD need real
# values here.
POSTGRES_HOST=
POSTGRES_DB=girlsclub
POSTGRES_USER=girlsclub
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_PORT=5432
