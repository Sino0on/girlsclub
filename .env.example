# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret-string
# Production (girlsclub.ques.kg): set this to False.
DJANGO_DEBUG=True
# Production example: girlsclub.ques.kg,www.girlsclub.ques.kg
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Needed for checkout/admin POSTs to pass CSRF checks once served over
# HTTPS behind nginx. Production example: https://girlsclub.ques.kg
CSRF_TRUSTED_ORIGINS=

# Public base URL of the site, no trailing slash (used to build the
# payment callback/redirect URLs, the QR verification link, and links
# inside the confirmation email). Production: https://girlsclub.ques.kg
SITE_URL=http://127.0.0.1:8000

# --- Ticket price (KGS / сом) ---
TICKET_PRICE_KGS=2000

# --- Contact numbers (shown as WhatsApp links: floating button on every
# page, plus a "having trouble paying?" note on checkout pages) ---
CONTACT_PHONES=+996706108061,+996500669172

# --- FreedomPay ---
# Ask your FreedomPay account manager for these. Until they're set (or
# while FREEDOMPAY_TEST_MODE=True), the "Buy ticket" flow uses a local
# fake payment page instead of the real gateway, so the whole order ->
# QR code -> email flow can be tested end-to-end without real keys.
#
# Before switching this to False: FreedomPay only accepts requests from
# whitelisted server IPs (register the production server's IP in the
# FreedomPay merchant cabinet first, or every call fails with
# "<IP> отсутствует в списке доверенных").
FREEDOMPAY_TEST_MODE=True
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
# Per https://docs.freedompay.kz (create-payment): POST here as
# multipart/form-data. Use the country-matching host if you're not on
# .kz — https://api.freedompay.uz/g2g/payment_page/ or
# https://api.freedompay.kg/g2g/payment_page/
FREEDOMPAY_API_URL=https://api.freedompay.kz/g2g/payment_page/

# --- Finik ---
# https://www.finik.kg/documentation/web-sdk/ — this is the *active*
# payment method ("Купить билет" sends buyers here). While
# FINIK_TEST_MODE=True (or credentials aren't set), it uses the same
# local fake payment page as FreedomPay's test mode, so the whole
# order -> QR -> email flow is testable without a live Finik account.
#
# Setup: generate a keypair (openssl genrsa -out finik_private.pem
# 2048 && openssl rsa -in finik_private.pem -pubout > finik_public.pem),
# send finik_public.pem to Finik when creating your WEB API key in
# their cabinet, keep finik_private.pem secret — put its contents
# below with real newlines replaced by literal "\n" (one .env line).
FINIK_TEST_MODE=True
# "beta" for testing against Finik's sandbox (no real money moves),
# "prod" once you're ready to accept real payments.
FINIK_MODE=beta
FINIK_API_KEY=
FINIK_PRIVATE_KEY=
# Your Finik account ID (Data.accountId) — where paid funds land.
FINIK_ACCOUNT_ID=
# Shown to the payer as the QR/payment name (Data.name_en).
FINIK_QR_NAME=FairyTale Picnic

# --- Email (for sending the QR code ticket) ---
# Default: prints emails to the runserver console, good for local testing.
# For real delivery: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Fairy Tale Picnic <no-reply@example.com>

# --- Database ---
# Leave POSTGRES_HOST empty to use local SQLite (e.g. plain
# "python manage.py runserver" outside Docker). docker-compose.yml sets
# POSTGRES_HOST=db itself — only POSTGRES_DB/USER/PASSWORD need real
# values here.
POSTGRES_HOST=
POSTGRES_DB=girlsclub
POSTGRES_USER=girlsclub
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_PORT=5432

# --- Initial admin account ---
# Not run automatically. If you want a Django admin account created
# from these values, run `docker compose exec web python manage.py
# ensure_superuser` yourself — it only ever creates the account once
# and never touches an existing one.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-strong-password

# --- Telegram moderator bot ---
# Create a bot via @BotFather, add it to your moderator group, then get
# the group's chat ID (negative number) — e.g. by adding @RawDataBot to
# the group temporarily, or calling getUpdates after messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODERATOR_CHAT_ID=
